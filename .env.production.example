# Easylook Website production deploy config
# 这份文件是 GitHub Actions production environment 的唯一配置源。
# 执行 `pnpm sync-github-production-env` (或 `bash scripts/sync-github-production-env.sh`) 后，会自动同步到 GitHub。

# 站点对外访问的基础路径，传给前端构建阶段的 PUBLIC_URL（默认 /）。
PUBLIC_URL=/

# 是否在 Release 发布后自动通过 upy Webhook 触发部署（true/false）。
UPY_AUTO_DEPLOY=false

# upy Server 入站 Webhook 完整地址。
# 路径项目名必须与服务器 <root>/deploy.yaml 中的 name 一致。
# 示例：https://deploy.example.com/api/v1/webhook/easylook-website
UPY_WEBHOOK_URL=https://deploy.example.com/api/v1/webhook/easylook-website

# 与服务器 <root>/deploy.yaml 中 webhook.secret 完全一致的密钥。
# sync 脚本会将其同步为 GitHub Secret。
UPY_WEBHOOK_SECRET=replace-with-webhook-secret
